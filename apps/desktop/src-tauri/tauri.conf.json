{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "djcast",
  "version": "0.3.1",
  "identifier": "io.github.danmarinescu79.djcast",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "djcast",
        "width": 1100,
        "height": 800,
        "minWidth": 960,
        "minHeight": 720,
        "backgroundColor": "#0e0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNjYyNkEwMEFEMkI5OTAKUldTUXVkSUtvQ1ptSWhVQ3hLWC9wUmlqREdkbkkvdUhYbDJTQWlBVzErOVo5S0xkbGw4UElNT3cK",
      "endpoints": ["https://github.com/danmarinescu79/djcast/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
